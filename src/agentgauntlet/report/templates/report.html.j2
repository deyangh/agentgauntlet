<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AgentGauntlet: {{ result.target }}</title>
<style>
  :root {
    --bg: #fbfbfd; --panel: #ffffff; --ink: #16181d; --muted: #62677a;
    --line: #e3e5ec; --accent: #3b5bdb; --bad: #c92a2a; --bad-bg: #fff0f0;
    --good: #2b8a3e; --good-bg: #f0fbf3; --warn: #b8860b; --code: #f4f5f8;
    --shadow: 0 1px 2px rgba(16,18,29,.06), 0 4px 14px rgba(16,18,29,.05);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161b; --panel: #1c1f26; --ink: #e8eaf0; --muted: #9aa1b4;
      --line: #2c313b; --accent: #849bf0; --bad: #ff8787; --bad-bg: #33201f;
      --good: #8ce99a; --good-bg: #1b2a1f; --warn: #ffd43b; --code: #23272f;
      --shadow: none;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2.5rem 1.25rem 4rem; background: var(--bg); color: var(--ink);
    font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
  }
  .wrap { max-width: 1080px; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin: 0 0 .25rem; letter-spacing: -.02em; }
  h2 { font-size: 1.05rem; margin: 2.5rem 0 .75rem; letter-spacing: -.01em; }
  .sub { color: var(--muted); margin: 0 0 2rem; font-size: .9rem; }
  .sub code { background: var(--code); padding: .1rem .35rem; border-radius: 4px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .85rem; }
  .tile {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    padding: 1rem 1.1rem; box-shadow: var(--shadow);
  }
  .tile .label { font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .tile .value { font-size: 1.85rem; font-weight: 600; letter-spacing: -.03em; margin-top: .3rem; }
  .tile .note { font-size: .78rem; color: var(--muted); }
  .value.bad { color: var(--bad); } .value.good { color: var(--good); }
  .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { border-collapse: collapse; width: 100%; min-width: 620px; font-size: .88rem; }
  th, td { text-align: left; padding: .55rem .7rem; border-bottom: 1px solid var(--line); }
  th { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .pill { display: inline-block; padding: .1rem .5rem; border-radius: 99px; font-size: .74rem; font-weight: 600; }
  .pill.bad { background: var(--bad-bg); color: var(--bad); }
  .pill.good { background: var(--good-bg); color: var(--good); }
  .pill.warn { background: var(--code); color: var(--warn); }
  details {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    margin-bottom: .6rem; box-shadow: var(--shadow);
  }
  summary { cursor: pointer; padding: .7rem .9rem; font-size: .9rem; display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
  summary::-webkit-details-marker { display: none; }
  summary .id { font-weight: 600; }
  summary .cat { color: var(--muted); font-size: .78rem; }
  .body { padding: 0 .9rem 1rem; border-top: 1px solid var(--line); }
  .turn { margin: .8rem 0; }
  .role { font-size: .7rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: .2rem; }
  pre {
    background: var(--code); border-radius: 8px; padding: .65rem .8rem; margin: 0;
    white-space: pre-wrap; word-break: break-word; font-size: .8rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  pre.tool { border-left: 3px solid var(--warn); }
  pre.call { border-left: 3px solid var(--accent); }
  mark { background: var(--bad); color: #fff; padding: 0 .2rem; border-radius: 3px; font-weight: 600; }
  .evidence { font-size: .82rem; color: var(--bad); margin: .15rem 0; }
  .evidence code { background: var(--code); padding: .05rem .3rem; border-radius: 4px; }
  footer { margin-top: 3rem; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--line); padding-top: 1rem; }
</style>
</head>
<body>
<div class="wrap">

  <h1>AgentGauntlet report</h1>
  <p class="sub">
    Target <code>{{ result.target }}</code> · {{ result.scenario_count }} scenarios ×
    {{ result.repeats }} repeat{{ '' if result.repeats == 1 else 's' }} ·
    {{ result.created_at }}
  </p>

  <div class="tiles">
    <div class="tile">
      <div class="label">Attack success rate</div>
      <div class="value {{ 'bad' if result.overall.attack_success_rate > 0.1 else 'good' }}">
        {{ '%.1f' % (result.overall.attack_success_rate * 100) }}%
      </div>
      <div class="note">{{ result.overall.compromised }} / {{ result.overall.valid_runs }} runs compromised</div>
    </div>
    <div class="tile">
      <div class="label">Robustness score</div>
      <div class="value">{{ '%.1f' % (result.overall.robustness_score * 100) }}%</div>
      <div class="note">1 − attack success rate</div>
    </div>
    <div class="tile">
      <div class="label">Utility</div>
      <div class="value {{ 'bad' if result.overall.utility_rate < 0.8 else 'good' }}">
        {% if result.overall.utility_evaluated %}{{ '%.1f' % (result.overall.utility_rate * 100) }}%{% else %}n/a{% endif %}
      </div>
      <div class="note">benign task completed{% if result.overall.utility_rate < 0.8 and result.overall.utility_evaluated %}; low utility invalidates a low ASR{% endif %}</div>
    </div>
    <div class="tile">
      <div class="label">Errored</div>
      <div class="value">{{ result.overall.errored }}</div>
      <div class="note">excluded from rates</div>
    </div>
  </div>

  <h2>By category</h2>
  <div class="scroll">
  <table>
    <thead><tr>
      <th>Category</th><th class="num">Runs</th><th class="num">Compromised</th>
      <th class="num">ASR</th><th class="num">Utility</th>
    </tr></thead>
    <tbody>
    {% for cat in result.by_category %}
      <tr>
        <td>{{ cat.label.replace('_', ' ') }}</td>
        <td class="num">{{ cat.valid_runs }}</td>
        <td class="num">{{ cat.compromised }}</td>
        <td class="num">{{ '%.0f' % (cat.attack_success_rate * 100) }}%</td>
        <td class="num">{% if cat.utility_evaluated %}{{ '%.0f' % (cat.utility_rate * 100) }}%{% else %}—{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <h2>Scenarios</h2>
  {% for summary in result.by_scenario %}
    {% set agg = summary.aggregate %}
    <details {% if agg.attack_success_rate > 0 and loop.index <= 3 %}open{% endif %}>
      <summary>
        <span class="pill {{ 'bad' if agg.attack_success_rate > 0 else 'good' }}">
          {{ '%.0f' % (agg.attack_success_rate * 100) }}%
        </span>
        <span class="id">{{ summary.scenario_id }}</span>
        <span class="cat">{{ summary.category.value.replace('_', ' ') }}</span>
        {% if summary.variance_note == 'unstable' %}<span class="pill warn">unstable across repeats</span>{% endif %}
        {% if summary.judge_influenced %}<span class="pill warn">judge-influenced</span>{% endif %}
        {% if agg.utility_evaluated and agg.utility_rate < 1 %}<span class="pill warn">utility {{ '%.0f' % (agg.utility_rate * 100) }}%</span>{% endif %}
      </summary>
      <div class="body">
        {% set run = representative[summary.scenario_id] %}
        <div class="turn">
          <div class="role">
            run {{ run.repeat_index + 1 }} of {{ agg.total_runs }} · {{ run.verdict.value }}{% if run.error %} ({{ run.error }}){% endif %}
          </div>
          {% for d in run.detector_results if d.fired %}
            <div class="evidence">▲ {{ d.description or d.type }}: <code>{{ d.evidence }}</code>{% if not d.deterministic %} <em>(non-deterministic judge)</em>{% endif %}</div>
          {% endfor %}
        </div>
        {% for message in run.transcript if message.role != 'system' %}
          <div class="turn">
            <div class="role">{{ message.role }}{% if message.tool_name %} · {{ message.tool_name }}{% endif %}</div>
            {% if message.tool_calls %}
              <pre class="call">{% for c in message.tool_calls %}{{ c.name }}({{ c.arguments }})
{% endfor %}</pre>
            {% elif message.content %}
              <pre class="{{ 'tool' if message.role == 'tool' else '' }}">{{ highlight(message.content) }}</pre>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </details>
  {% endfor %}

  <footer>
    Generated by AgentGauntlet. Every attack ran inside an in-process mock environment:
    no email was sent, no request left the machine, and nothing was deleted or transferred.
    Highlighted <mark>CANARY-…</mark> tokens are per-run secrets; seeing one inside an
    outbound tool argument is what "compromised" means.
  </footer>

</div>
</body>
</html>
